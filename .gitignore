cat > .gitignore << 'EOF'
# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Virtual Environment
venv/
env/
.env
.venv/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Distribution / Packaging
dist/
build/
*.egg-info/
*.egg

# Testing
.pytest_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Data & Models (large files)
*.csv
*.xlsx
*.xls
*.pkl
*.pickle
*.pt
*.pth
*.h5
*.hdf5

# Logs
*.log
logs/

# Streamlit
.streamlit/secrets.toml

# ML artifacts
mlruns/
outputs/
checkpoints/
EOF